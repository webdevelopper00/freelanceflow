{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 5000",
    "dev": "npx nodemon --exec npx tsx src/index.ts",
    "postinstall": "prisma generate",
    "build": "npx tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:generate:prod": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-prod": "tsx prisma/seed-prod.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "validator": "^13.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.5",
    "@types/validator": "^13.12.2",
    "kill-port": "^1.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2"
  }
}
